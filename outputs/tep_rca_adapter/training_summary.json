{
  "adapter_name": "tep_rca",
  "base_model": "OpenGVLab/InternVL2-2B",
  "lora": {
    "r": 16,
    "alpha": 32,
    "dropout": 0.05,
    "target_modules": [
      "wqkv",
      "wo",
      "w1",
      "w2",
      "w3"
    ],
    "bias": "none"
  },
  "training": {
