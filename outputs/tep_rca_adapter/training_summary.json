    "bnb_4bit_quant_type": "nf4",
    "bnb_4bit_use_double_quant": true,
    "weight_decay": 0.01,
    "max_grad_norm": 1.0,
    "logging_steps": 10,
    "save_steps": 200,
    "eval_steps": 200,
    "save_total_limit": 2,
