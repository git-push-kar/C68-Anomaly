# ── ML / Data / Outputs (generated artifacts) ─────────────────────────
# Keep directory structure via .gitkeep, ignore large generated files
outputs/
!outputs/.gitkeep
!outputs/tep_rca_adapter/evaluation*.json
!outputs/tep_rca_adapter/training_summary.json
outputs/**/*.pt
outputs/**/*.pth
outputs/**/*.safetensors
outputs/**/*.bin
outputs/**/*.pkl
outputs/**/*.db
outputs/**/*.sqlite

data/raw/
!data/raw/.gitkeep
!data/raw/**/.gitkeep
# Ignore large raw/processed dumps (TEP is ~several GB); keep placeholders
data/raw/**/*.csv
data/raw/**/*.mat
data/raw/**/*.dat
data/processed/
!data/processed/.gitkeep
data/processed/**/*.npy
data/processed/**/*.npz
data/processed/**/*.pkl
data/llm/
!data/llm/.gitkeep
data/llm/**/*.jsonl
data/llm/**/*.arrow
data/llm/**/*.parquet

