# ── ML / Data / Outputs (generated artifacts) ─────────────────────────
# Keep directory structure via .gitkeep, ignore large generated files
outputs/*
!outputs/.gitkeep
!outputs/evaluation/
!outputs/evaluation/*
!outputs/llm_dataset_v2/
!outputs/llm_dataset_v2/*
outputs/**/*.pt
outputs/**/*.pth
outputs/**/*.safetensors
outputs/**/*.bin
outputs/**/*.pkl
outputs/**/*.db
outputs/**/*.sqlite
# Smoke изоляции — never push smoke temp dirs (see prepare_tep.py --smoke)
outputs_smoke/
outputs/*_smoke/
data/processed_smoke/
data/*_smoke/


!data/raw/.gitkeep
!data/raw/**/.gitkeep
# Ignore large raw/processed dumps (TEP is ~several GB); keep placeholders
data/raw/**/*.csv
data/raw/**/*.mat
data/raw/**/*.dat
data/processed/*
!data/processed/.gitkeep
!data/processed/manifests/
!data/processed/manifests/*
data/processed/**/*.npy
data/processed/**/*.npz
data/processed/**/*.pkl
data/llm/*
!data/llm/.gitkeep
data/llm/**/*.jsonl
data/llm/**/*.arrow
data/llm/**/*.parquet

