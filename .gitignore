*.py[cod]
*$py.class
*.so
*.pyd
*.pyo
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
*.whl
pip-log.txt
pip-delete-this-directory.txt
MANIFEST

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# ── ML / Data / Outputs (generated artifacts) ─────────────────────────
# Keep directory structure via .gitkeep, ignore large generated files
outputs/*
!outputs/.gitkeep
!outputs/evaluation/
!outputs/evaluation/*
!outputs/llm_dataset_v2/
!outputs/llm_dataset_v2/*
outputs/**/*.pt
outputs/**/*.pth
outputs/**/*.safetensors
outputs/**/*.bin
outputs/**/*.pkl
outputs/**/*.npz
# The live detector's threshold artifact: small, hand-restorable, and its
# absence stops the app from starting (Phase 1 patch A0). Everything else
# next to it stays ignored.
!outputs/anomaly_detector/
outputs/anomaly_detector/*
!outputs/anomaly_detector/threshold.json
!outputs/anomaly_detector/config.json
# Baseline statistics the event builder dereferences; reconstructible and
# verified against the fitted scaler (scripts/restore_baseline_stats.py).
!outputs/preprocessing/
outputs/preprocessing/*
!outputs/preprocessing/baseline_stats.json
!outputs/preprocessing/baseline_provenance.json
# Training run 1 (Protocol A, seed 42): the bytes that *describe* the run are
# tracked, the 4 GB of weights and optimizer state next to them are not. A
# clone can therefore read how the run went and check the adapter's hashes
# without being able to mistake itself for a copy that can evaluate the run.
!outputs/tep_rca_v2_protocolA_seed42/
outputs/tep_rca_v2_protocolA_seed42/*
!outputs/tep_rca_v2_protocolA_seed42/training_summary.json
!outputs/tep_rca_v2_protocolA_seed42/train_telemetry.jsonl
!outputs/tep_rca_v2_protocolA_seed42/train_telemetry.log
!outputs/tep_rca_v2_protocolA_seed42/train_console.log
!outputs/tep_rca_v2_protocolA_seed42/adapter_config.json
# The evaluation evidence for that run: the six small JSONs its numbers come
# from (checkpoint table, selection, scoring parity, decode speed, generation,
# follow-up sanity). The prediction files next to them stay ignored — they are
# megabytes of per-item rows and are regenerated by scripts/eval_protocolA.py.
!outputs/benchmark_v2/
outputs/benchmark_v2/*
!outputs/benchmark_v2/eval/
outputs/benchmark_v2/eval/*
!outputs/benchmark_v2/eval/checkpoint_table.json
!outputs/benchmark_v2/eval/selected_checkpoint.json
!outputs/benchmark_v2/eval/scoring_parity.json
!outputs/benchmark_v2/eval/decode_speed.json
!outputs/benchmark_v2/eval/generation_512.json
!outputs/benchmark_v2/eval/followup_sanity.json
outputs/**/*.db
outputs/**/*.sqlite
# Smoke изоляции — never push smoke temp dirs (see prepare_tep.py --smoke)
outputs_smoke/
outputs/*_smoke/
data/processed_smoke/
data/*_smoke/

# Quarantine: keep manifest/docs/provenance, never commit model weights/checkpoints
quarantine/**/checkpoint-*/
quarantine/**/*.safetensors
quarantine/**/*.pt
quarantine/**/*.pth
quarantine/**/*.bin
quarantine/**/tokenizer.json
quarantine/**/vocab.json
quarantine/**/merges.txt


!data/raw/.gitkeep
!data/raw/**/.gitkeep
# Ignore large raw/processed dumps (TEP is ~several GB); keep placeholders
data/raw/**/*.csv
data/raw/**/*.mat
data/raw/**/*.dat
data/processed/*
!data/processed/.gitkeep
!data/processed/manifests/
!data/processed/manifests/*
data/processed/**/*.npy
data/processed/**/*.npz
data/processed/**/*.pkl
data/llm/*
!data/llm/.gitkeep
data/llm/**/*.jsonl
data/llm/**/*.arrow
data/llm/**/*.parquet
# v1 holdout set mirrors the v0 convention: rows ignored, metadata tracked
data/llm_v1/*
!data/llm_v1/split_metadata.json
data/llm_v1/**/*.jsonl
data/llm_v1/**/*.arrow
data/llm_v1/**/*.parquet

