# ── ML / Data / Outputs (generated artifacts) ─────────────────────────
# Ignore heavy binaries/checkpoints, but TRACK results/eval/inference (json/md/csv/txt)
!outputs/.gitkeep
outputs/*.pt
outputs/**/*.pt
outputs/*.pth
outputs/**/*.pth
outputs/*.safetensors
outputs/**/*.safetensors
outputs/*.bin
outputs/**/*.bin
outputs/*.pkl
outputs/**/*.pkl
outputs/*.db
outputs/**/*.db
outputs/*.sqlite
outputs/**/*.sqlite
outputs/*.onnx
outputs/**/*.onnx
outputs/**/checkpoint-*/
outputs/**/checkpoint_*/
outputs/**/tokenizer.model
# keep results human-readable – explicitly allow (no ignore needed, but ensure not blocked)
!outputs/**/*.json
!outputs/**/*.md
!outputs/**/*.csv
!outputs/**/*.txt
!outputs/**/*.yaml
!outputs/**/*.yml
!outputs/**/*.jinja

data/raw/
!data/raw/.gitkeep
!data/raw/**/.gitkeep
# Ignore large raw/processed dumps (TEP is ~several GB); keep placeholders
data/raw/**/*.csv
data/raw/**/*.mat
data/raw/**/*.dat
data/processed/
!data/processed/.gitkeep
data/processed/**/*.npy
data/processed/**/*.npz
data/processed/**/*.pkl
data/llm/
!data/llm/.gitkeep
data/llm/**/*.jsonl
data/llm/**/*.arrow
data/llm/**/*.parquet

# ── Checkpoints / HF cache ────────────────────────────────────────────
checkpoints/
*.ckpt
.cache/
hf_cache/
transformers_cache/

